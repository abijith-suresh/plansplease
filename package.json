{
  "name": "planview-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "better-auth": "1.7.12",
    "solid-js": "1.9.17",
    "vite": "8.3.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "postinstall": "node scripts/prepare-auth-adapter.mjs",
    "precheck": "node scripts/prepare-auth-adapter.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start --workspace @planview/app",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release-policy": "node scripts/release-policy.mjs",
    "check": "npm run release-policy && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:check": "npm pack --dry-run --workspace @abijith-suresh/planview",
    "pack:verified": "npm pack --workspace @abijith-suresh/planview --ignore-scripts",
    "publish:verified": "node scripts/publish-verified.mjs",
    "release": "node scripts/release.mjs",
    "changeset:check": "node scripts/changeset-presence.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\" && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run check && npm run build",
    "version-packages": "npm run release-policy && changeset version && npm install --package-lock-only --ignore-scripts",
    "local": "node scripts/local-dev.mjs",
    "local:reset": "node scripts/local-dev.mjs reset",
    "test:upload:installed": "node --experimental-strip-types scripts/upload-protocol-smoke.mjs",
    "test:manager:browser": "npm run build --workspace @abijith-suresh/planview && node scripts/manager-browser-smoke.mjs"
  },
  "devDependencies": {
    "@astrojs/compiler": "2.13.1",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "2.31.1",
    "@changesets/parse": "0.4.3",
    "playwright": "1.64.1",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
