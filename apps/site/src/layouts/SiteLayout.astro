---
import "../styles/global.css";
// biome-ignore lint/correctness/noUnusedImports: Astro uses the layout helper below.
import { appSignInUrl } from "../lib/app-url";

interface Props {
  title: string;
  description: string;
  activePath?: "features" | "cli" | "about" | "docs" | "pricing" | "faq" | "privacy" | "mcp" | "";
  canonical?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro uses these props in the document template below.
const { title, description, activePath = "", canonical } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the document template below.
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
if (!Astro.site) throw new Error("The site origin must be configured before building");
// biome-ignore lint/correctness/noUnusedVariables: Astro uses metadata below.
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses metadata below.
const socialImage = new URL(`${assetBase}social-preview.png?v=2`, Astro.site).href;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses metadata below.
const socialImageAlt = "plansplease. Keep the pages your agent makes.";
const homeHref = baseUrl === "/" ? "/" : baseUrl.replace(/\/$/, "");
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this helper in the document template below.
const pageHref = (path: string) => `${homeHref === "/" ? "" : homeHref}/${path}/`;

// biome-ignore lint/correctness/noUnusedVariables: Astro maps this array in the template below.
const navItems = [
  { key: "features", label: "Features" },
  { key: "docs", label: "Docs" },
  { key: "cli", label: "CLI" },
  { key: "pricing", label: "Pricing" },
  { key: "faq", label: "FAQ" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={`${assetBase}favicon.ico?v=2`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${assetBase}favicon.svg?v=2`} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={`${assetBase}apple-touch-icon.png?v=2`} sizes="180x180" />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="plansplease" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="site-shell site-header-row">
        <a class="brand" href={homeHref} aria-label="plansplease home">
          <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                class:list={["site-nav-link", { "is-current": activePath === item.key }]}
                href={pageHref(item.key)}
                aria-current={activePath === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="site-nav-cta" href={appSignInUrl}>Sign in</a>
        </nav>

        <details class="mobile-menu">
          <summary class="mobile-menu-toggle" aria-label="Open site menu">
            <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Menu</span>
          </summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            {
              navItems.map((item) => (
                <a
                  class:list={["mobile-menu-link", { "is-current": activePath === item.key }]}
                  href={pageHref(item.key)}
                  aria-current={activePath === item.key ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "about" }]}
              href={pageHref("about")}
              aria-current={activePath === "about" ? "page" : undefined}
            >About</a>
            <a class="mobile-menu-cta" href={appSignInUrl}>Sign in with GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="site-shell site-main-shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-shell">
        <div class="site-footer-main">
          <div class="footer-brand">
            <a class="brand" href={homeHref} aria-label="plansplease home">
              <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
            </a>
            <p>Local previews and a cloud workspace for the HTML your agent writes.</p>
          </div>

          <div>
            <p class="footer-heading">Product</p>
            <nav class="footer-links" aria-label="Product links">
              <a class="footer-link" href={pageHref("features")}>Features</a>
              <a class="footer-link" href={pageHref("pricing")}>Pricing</a>
              <a class="footer-link" href={pageHref("cli")}>CLI</a>
            </nav>
          </div>

          <div>
            <p class="footer-heading">Resources</p>
            <nav class="footer-links" aria-label="Resource links">
              <a class="footer-link" href={pageHref("docs")}>Docs</a>
              <a class="footer-link" href={pageHref("faq")}>FAQ</a>
              <a class="footer-link" href={pageHref("about")}>About</a>
            </nav>
          </div>

          <div>
            <p class="footer-heading">Project</p>
            <nav class="footer-links" aria-label="Project links">
              <a class="footer-link" href="https://github.com/abijith-suresh/plansplease">GitHub</a>
              <a class="footer-link" href={pageHref("privacy")}>Privacy</a>
              <a class="footer-link" href={appSignInUrl}>Sign in</a>
            </nav>
          </div>
        </div>

        <div class="site-footer-bottom">
          <p>plansplease</p>
          <p>Cloud files have public URLs during alpha. Avoid sensitive uploads.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
