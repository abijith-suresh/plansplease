---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Pricing | plansplease"
  description="Free during alpha. Paid plans are still being planned."
  activePath="pricing"
>
  <header class="page-heading">
    <div>
      <h1>Pricing</h1>
      <p>Free during alpha. Paid plans are still being planned.</p>
    </div>
  </header>

  <section class="content-section" aria-label="Plans">
    <div class="pricing-grid">
      <article class="pricing-card pricing-card-current">
        <div class="pricing-header">
          <span class="pricing-label">Current / Alpha</span>
          <h2>Free</h2>
        </div>
        <div class="pricing-price-box">
          <span class="price-number">$0</span>
          <span class="price-tenure">during alpha</span>
        </div>
        <p class="pricing-intro">Try plansplease for free while we test the cloud workspace.</p>
        <ul class="pricing-features">
          <li>Local HTML and folder previews</li>
          <li>Cloud copy of single-file HTML pages</li>
          <li>HTML files up to 8 MiB each</li>
          <li>Account workspace with GitHub sign-in; public file URLs during alpha</li>
          <li>Full support for modern CSS, Tailwind CDN, and Canvas</li>
          <li>Standard community support via GitHub</li>
        </ul>
      </article>

      <article class="pricing-card">
        <div class="pricing-header">
          <span class="pricing-label future">Planned</span>
          <h2>Paid plans</h2>
        </div>
        <div class="pricing-price-box">
          <span class="price-number">To come</span>
          <span class="price-tenure">after alpha</span>
        </div>
        <p class="pricing-intro">We'll set pricing and storage limits after learning how people use the service.</p>
        <ul class="pricing-features">
          <li>Higher storage limits</li>
          <li>Private file storage</li>
        </ul>
      </article>
    </div>

    <p class="page-note">
      Questions about plans? <a href="/faq/">Check the FAQ</a> or join the
      discussion on <a href="https://github.com/abijith-suresh/plansplease">GitHub</a>.
    </p>
  </section>
</SiteLayout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: clamp(2.25rem, 4vw, 3rem);
    border: 1px solid var(--night-border);
    border-radius: var(--radius-lg);
    background: var(--night-card);
    transition: border-color 160ms ease;
  }

  .pricing-card-current {
    border-color: var(--night-border-hover);
    background: var(--night-card-elevated);
  }

  .pricing-card:not(.pricing-card-current):hover {
    border-color: var(--night-border-hover);
  }

  .pricing-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pricing-label {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
    color: var(--mint);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .pricing-label.future {
    background: transparent;
    border-color: var(--night-border-hover);
    color: var(--night-muted);
  }

  .pricing-card h2 {
    margin: 0;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.7rem;
    font-weight: 650;
    letter-spacing: -0.028em;
  }

  .pricing-price-box {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .price-number {
    color: var(--text-white);
    font-family: var(--display);
    font-size: 2.8rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .price-tenure {
    color: var(--night-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .pricing-intro {
    margin: 0 0 2rem;
    color: var(--night-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .pricing-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
    flex-grow: 1;
  }

  .pricing-features li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .pricing-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--mint);
    font-weight: 600;
  }

  .pricing-card:not(.pricing-card-current) .pricing-features li::before {
    color: var(--night-subtle);
  }

  @media (max-width: 860px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
