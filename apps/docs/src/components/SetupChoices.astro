---
// biome-ignore lint/correctness/noUnusedVariables: Astro renders the choices below.
const { basePath } = Astro.props as { basePath: string };
// biome-ignore lint/correctness/noUnusedVariables: Astro renders these navigation links below.
const choices = [
  {
    path: "guides/install-cli/",
    title: "Install the CLI",
    description: "Preview HTML locally and test uploads in the local workspace.",
  },
  {
    path: "guides/mcp/",
    title: "Connect MCP",
    description: "Test authenticated document tools in the local workspace.",
  },
  {
    path: "guides/self-hosting/",
    title: "Self-hosting",
    description: "Run local previews yourself and see what cloud hosting needs today.",
  },
];
---
<nav class="setup-choices" aria-label="Setup guides">
  {choices.map((choice) => (
    <a class="setup-choice" href={`${basePath}${choice.path}`}>
      <div><strong>{choice.title}</strong><p>{choice.description}</p></div>
      <span aria-hidden="true">→</span>
    </a>
  ))}
</nav>
