{
  "name": "@planview/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @planview/core && node ../../scripts/prepare-auth-adapter.mjs",
    "prebuild": "npm run build --workspace @planview/core && node ../../scripts/prepare-auth-adapter.mjs",
    "pretest": "npm run build --workspace @planview/core && node ../../scripts/prepare-auth-adapter.mjs",
    "pretypecheck": "npm run build --workspace @planview/core && node ../../scripts/prepare-auth-adapter.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck:test && node --experimental-strip-types --test \"test/**/*.test.mts\"",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@convex-dev/better-auth": "^0.12.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.6",
    "better-auth": "1.7.12",
    "convex": "^1.46.0",
    "nitro": "3.0.260903-beta",
    "solid-js": "1.9.17",
    "uploadthing": "^7.7.4",
    "vite": "8.3.5",
    "zod": "4.6.7",
    "@planview/core": "0.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@jridgewell/resolve-uri": "3.1.2",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
