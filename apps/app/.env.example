# For the full isolated local workspace, use `npm run local` at the repo root.
# It generates private development configuration under .planview-local/ without
# reading or overwriting this workspace's .env.local. See the repository development guide in apps/docs.
# The variables below describe the separate hosted-backend development workflow.

# Generated by `npx convex dev` for the selected Convex deployment.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Optional server-side aliases for Railway or another Node host. The app also
# accepts the VITE_* names written by the Convex CLI during local development.
# CONVEX_URL=
# CONVEX_SITE_URL=

# Configure these on the Convex deployment with `npx convex env set`.
# They must not be exposed to the browser or committed to git.
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional public app build configuration for the marketing sign-out destination.
# Set before building the app; this URL is intentionally exposed to the browser.
# VITE_PUBLIC_SITE_URL=https://your-marketing-site.example
# Documentation links, set before building; a path prefix is supported.
# VITE_PUBLIC_DOCS_URL=https://plansplease-docs-staging.up.railway.app

# UploadThing storage for standalone HTML files. This is server-only; do not
# prefix it with VITE_ or expose it to the browser.
# UPLOADTHING_TOKEN=
# Required by the app server and Convex deployment to authorize metadata writes.
# DOCUMENT_MUTATION_SECRET=
# Use the public app origin on the Node app too. Convex needs the same SITE_URL
# for OAuth redirect URLs and its CIMD transport callback.
# The app also uses this origin for generic social preview image URLs.
# SITE_URL=http://localhost:3000
# Shared by the app server and Convex for private CIMD metadata fetches (32+ bytes).
# CIMD_FETCH_SECRET=
# Set on both the app and Convex only when testing older MCP clients.
# OpenCode 1.x also needs a pre-registered native client for its loopback callback.
# MCP_ALLOW_LEGACY_CLIENTS=true
# Set this only if UploadThing cannot infer the public staging URL.

# Convex deployment only, optional: default account storage limit is 500 decimal MB.
# ACCOUNT_STORAGE_QUOTA_BYTES=500000000
